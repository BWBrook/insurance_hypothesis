# Python
__pycache__/
*.py[cod]
*.pyo

# Environments
.venv/

# Test artifacts
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Data previews (regenerated)
data/sim/preview/
data/sim/grid/

